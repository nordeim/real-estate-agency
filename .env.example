# MAISON ESTATE — Real Estate Agency
# Copy to `.env` and adjust values. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for local development/demo (default; zero external services).
DATABASE_URL="file:./db/custom.db"

# PostgreSQL for production — switch prisma/schema.prisma provider to
# "postgresql", point DATABASE_URL at your instance, then re-run
# `bun run db:push && bun run db:seed`.
# DATABASE_URL="postgresql://maison:secret@localhost:5432/maison_dev"

# ---------------------------------------------------------------------------
# Auth (NextAuth v4)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="set-me-with-openssl-rand-base64-32"
# Canonical origin of the deployed app (used for redirects/callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth. The /login page always shows the "Continue with
# Google" button (matching the original app); without the values below it
# displays a setup notice instead of starting the flow. Create credentials
# at https://console.cloud.google.com.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" (after filling the two values above) to activate the flow.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Optional: canonical public URL used as the metadataBase for OpenGraph/
# Twitter tags and as the absolute sitemap URL in robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
