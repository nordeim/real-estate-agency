# MAISON ESTATE — Real Estate Agency
# Copy to `.env` and adjust values. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for local development/demo (default; zero external services).
DATABASE_URL="file:./db/custom.db"

# PostgreSQL for production — switch prisma/schema.prisma provider to
# "postgresql", point DATABASE_URL at your instance, then re-run
# `bun run db:push && bun run db:seed`.
# DATABASE_URL="postgresql://maison:secret@localhost:5432/maison_dev"

# ---------------------------------------------------------------------------
# Auth (NextAuth v4)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="set-me-with-openssl-rand-base64-32"
# Canonical origin of the deployed app (used for redirects/callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth — leave empty to hide the "Continue with Google"
# button on /login. Create credentials at https://console.cloud.google.com.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "true" (after filling the two values above) to surface the button.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Optional: canonical public URL used in metadata/OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
